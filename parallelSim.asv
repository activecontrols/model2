dictObj = Simulink.data.dictionary.open('Variables.sldd');
dataSect = getSection(dictObj, 'Design Data');
constantsASTRA = getValue(getEntry(dataSect, 'constantsASTRA'));

%%
gainNum = 4;
a = 1.6;
b = 2;
gains  = wblrnd(a, b, 1, gainNum);
gainStrs = arrayfun(@num2str, gains,  'UniformOutput', false);
exhaustiveVars(1) = simulink.multisim.BlockParameter("SimulationLoop/Plant Simulation/" + ...
    "Disturbance Models and Integrator/Wind/Wind Gain", "Gain", gainStrs);

%%
coVarNum = 1;
covariences = linspace(0, 5, coVarNum);
coVarStr = arrayfun(@num2str, covariences,  'UniformOutput', false);
exhaustiveVars(2) = simulink.multisim.BlockParameter("SimulationLoop/Plant Simulation/" + ...
    "Disturbance Models and Integrator/Wind/Covar", "Value", coVarStr);

%%
MoIGains = 0.5:1:3.5;
numMoI = length(MoIGains);
constsArrJ(1:numMoI) = constantsASTRA;
for i = 1:length(MoIGains)
    constsArrJ(i).J = constsArrJ(i).J(:,:) * MoIGains(i);
end
exhaustiveVars(3) = simulink.multisim.Variable("constantsASTRA", constsArrJ);

% %%
% massGains = 0.95:0.05:1.05;
% numMass = length(massGains);
% constsArrM(1:numMass) = constantsASTRA;
% for i = 1:length(massGains)
%     constsArrM(i).m = constsArrM(i).m * massGains(i);
% end
% exhaustiveVars(4) = simulink.multisim.Variable("constantsASTRA", constsArrM);
% 
% %%
% rTBGains = 0.7:0.3:1.3;
% numRTB = length(rTBGains);
% constsArrRTB(1:numRTB) = constantsASTRA;
% for i = 1:length(rTBGains)
%     constsArrRTB(i).rTB = constsArrRTB(i).rTB * rTBGains(i);
% end
% exhaustiveVars(5) = simulink.multisim.Variable("constantsASTRA", constsArrRTB);

%%
simulink.multisim.ModelParameter(SimulationMode="rapid-accelerator");
exhaustive = simulink.multisim.Exhaustive(exhaustiveVars);
designStudy = simulink.multisim.DesignStudy("SimulationLoop", exhaustive);

% clearvars -except accelBias constantsASTRA Checkpoints distMode dt dt_SIM...
%     gyroBias HoldTimeReqs IMU_Rate K magDistMatrix slBus1 u0 x0 designStudy windMerid windZonal

%%
% setenv('MW_PCT_TRANSPORT_HEARTBEAT_INTERVAL', '600')
myCluster = parcluster('Processes');
delete(myCluster.Jobs);

simOut = parsim(designStudy, 'UseFastRestart', 'on', 'ShowProgress', 'on');
outputs = simOut.fetchOutputs();

%%
outputs = out;
outlen = length(outputs);

errSeries = {outputs.totalError.Data};
% gustSeries = {outputs.maxGust.Data};
MoISeries = {outputs.MoI.Data};

totErr = zeros(outlen, 1);
% maxGusts = zeros(outlen, 1);
MoIgains = zeros(outlen, 1);

for i = 1:outlen
    totErr(i) = errSeries{i}(end);
    % maxGusts(i) = max(gustSeries{i});
    MoIGainMtrx = MoISeries{i} ./ constantsASTRA.J;
    MoIgains(i) = MoIGainMtrx(1,1);
end

% save('multiSimOut.mat', "outputs", "constantsASTRA"); % VERY BIG FILE
% save('multiSimData.mat', "totErr", "maxGusts", "MoIgains");

% clearvars